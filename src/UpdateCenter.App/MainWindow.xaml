<Window x:Class="UpdateCenter.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Codex Update Center · Community" Width="1100" Height="780" MinWidth="760" MinHeight="600" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Codex 更新中心" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" Margin="0,8,0,18" FontSize="12"/>
   <TextBlock Text="自动识别安装方式，准备官方更新。确认后只更新所选安装；不更改账号、聊天记录或其他实例。" Margin="0,0,0,18"/>
  </StackPanel>
  <WrapPanel Grid.Row="1"><Button x:Name="ScanButton" Content="重新扫描" Click="ScanClick"/><Button x:Name="AddButton" Content="添加 npm 安装目录…" Click="AddClick"/><Button Content="官方安装说明 ↗" Click="HelpClick"/>
   <CheckBox x:Name="AutoBox" Content="打开后自动检查并准备" VerticalAlignment="Center" Margin="6,0,0,10" Checked="AutoChanged" Unchecked="AutoChanged"/>
  </WrapPanel>
  <Grid Grid.Row="2" Margin="0,10,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="CountText" Text="正在识别安装…" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <ListBox x:Name="InstallList" Grid.Row="1" SelectionChanged="SelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="检测到的 Codex 安装">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,12"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Version}" Margin="0,5"/><TextBlock Text="{Binding Detail}" FontSize="12"/><TextBlock Text="{Binding Location}" FontSize="11" Margin="0,7,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="2" Text="一个安装会自动选中；多个安装分别管理。未识别的便携版和 WSL 请用原安装工具更新。" FontSize="12" Margin="0,12,0,0"/>
   </Grid>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="当前任务" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock x:Name="StatusText" Text="正在读取本地状态…" FontSize="16" Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite"/>
    <ProgressBar x:Name="Activity" Height="4" IsIndeterminate="False" Margin="0,0,0,18"/>
    <TextBlock x:Name="DetailText" Margin="0,0,0,18"/>
    <TextBlock x:Name="NetworkText" Margin="0,0,0,12"/>
    <CheckBox x:Name="AllowMetered" Content="仅本次允许计费或状态未知的网络下载" Margin="0,0,0,18"/>
    <WrapPanel><Button x:Name="PrepareButton" Content="检查并准备更新" Click="PrepareClick" IsEnabled="False"/><Button x:Name="PauseButton" Content="暂停下载" Click="PauseClick" IsEnabled="False"/><Button x:Name="InstallButton" Content="确认安装…" Click="InstallClick" IsEnabled="False"/></WrapPanel>
    <WrapPanel><Button Content="打开任务目录" Click="FolderClick"/><Button x:Name="RestartButton" Content="保留旧文件，重新准备" Click="RestartClick" IsEnabled="False"/></WrapPanel>
    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" Padding="14" Margin="0,12,0,0"><StackPanel>
     <TextBlock Text="下载与安装位置" FontWeight="SemiBold"/><TextBlock Text="C 盘空间满足预算和安全余量时优先下载到 C 盘。空间不足时选择已识别的内部固定盘。Windows 桌面应用的实际安装位置由 Windows 管理。" Margin="0,8,0,0"/>
    </StackPanel></Border>
    <TextBlock x:Name="WarningText" Margin="0,14,0,0" FontSize="12"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <TextBlock Grid.Row="3" Text="独立社区项目，与 OpenAI 无隶属关系。预览版：Windows 部署兼容性矩阵仍待虚拟机验收。" FontSize="12"/>
 </Grid>
</Window>
